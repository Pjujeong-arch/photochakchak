{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/rank.js": { "maxDuration": 60, "includeFiles": "src/api/**" },
    "api/[...path].js": { "maxDuration": 60, "includeFiles": "src/api/**" }
  },
  "rewrites": [
    { "source": "/api/auth/google", "destination": "/api/login" },
    { "source": "/api/auth/logout", "destination": "/api/logout" }
  ],
  "headers": [
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
