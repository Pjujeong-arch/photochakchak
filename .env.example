# Copy to `.env.local` (gitignored) and fill values.
# Never commit real secrets. Never put API keys in frontend code.

PORT=4173

# Google Identity Services (OAuth Web Client ID — public, used for GIS button)
GOOGLE_CLIENT_ID=

# Optional: OAuth client secret (server-only; never expose to the browser)
GOOGLE_CLIENT_SECRET=

# Optional: signed session cookie (Vercel serverless). Defaults to GOOGLE_CLIENT_ID.
SESSION_SECRET=

# Google AI / Gemini (server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
