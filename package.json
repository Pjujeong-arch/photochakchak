{
  "name": "photochakchak",
  "private": true,
  "version": "1.1.0",
  "description": "포토착착 — 사진·영상을 연월 폴더로 복사 정리",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "preview": "node src/cli.js preview",
    "sort": "node src/cli.js copy",
    "undo": "node src/cli.js undo",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run lint && npm run typecheck && node scripts/build.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.2.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2"
  }
}
