rules_version = '2';

# Photochakchak — Firebase Security Rules examples (owner-only CRUD)
# userId must match request.auth.uid from Firebase Auth (e.g. Google Sign-In).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/rankJobs/{jobId} {
      allow read, update, delete: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['mode', 'createdAt', 'userId'])
        && request.resource.data.mode in ['sample', 'top10']
        && request.resource.data.userId == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
